{
  "name": "sanity-plugin-note-field",
  "version": "4.0.0",
  "description": "Display inline notes within your schemas",
  "keywords": [
    "custom field",
    "input",
    "note",
    "sanity",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/ndimatteo/sanity-plugin-note-field#readme",
  "bugs": {
    "url": "https://github.com/ndimatteo/sanity-plugin-note-field/issues"
  },
  "license": "MIT",
  "author": "Nick DiMatteo <hello@nickdimatteo.com>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ndimatteo/sanity-plugin-note-field.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "clean": "rimraf dist",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/ui": "^4.0.6",
    "lodash-es": "^4.17.23"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "12.3.0",
    "@sanity/plugin-kit": "^10.0.8",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.14",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "rimraf": "^6.1.3",
    "sanity": "^6.10.1",
    "styled-components": "^6.1.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^19",
    "sanity": "^6.0.0-0"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "packageManager": "yarn@4.18.0"
}
