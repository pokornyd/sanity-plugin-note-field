{
  "extends": "./tsconfig.settings",
  "include": ["./src"],
  "exclude": [
    "./src/**/__fixtures__",
    "./src/**/__mocks__",
    "./src/**/*.test.ts",
    "./src/**/*.test.tsx"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    // pkg-utils 12+ takes JSX handling from here, and "preserve" (what plugin-kit's tsconfig check
    // wants) ships raw JSX in dist that Studio can't parse. See sanity-io/plugins#1952.
    "jsx": "react-jsx",
    "module": "preserve",
    "noEmit": true
  }
}
